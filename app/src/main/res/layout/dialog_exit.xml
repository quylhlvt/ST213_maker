<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80545454"
        android:gravity="center">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/titleFame"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginBottom="-23dp"
            app:cardBackgroundColor="#40000000"
            app:cardElevation="8dp"
            app:cardCornerRadius="18dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
            app:layout_constraintDimensionRatio="1.1:0.40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:layout_marginBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_title_dialog">

                <TextView
                    android:id="@+id/txtTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="@font/rufing_personaluse"
                    android:gravity="center"
                    android:text="@string/loading"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:strokeJoinStyle="miter" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="58dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="2.44:1.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <TextView
                android:id="@+id/txtContent1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:elevation="1dp"
                android:fontFamily="@font/rufing_personaluse"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:text="@string/haven_t_saved_it_yet_do_you_want_to_exit"
                android:textColor="@color/app_color"
                android:textSize="16dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/btnOk"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:src="@drawable/bg_dialog"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/rufing_personaluse"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:text="@string/haven_t_saved_it_yet_do_you_want_to_exit"
                android:textColor="@color/app_color"
                android:textSize="16sp"

                app:layout_constraintBottom_toTopOf="@+id/btnNo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <TextView
                android:id="@+id/btnOk"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_btn_loading_yes"
                android:fontFamily="@font/rufing_personaluse"
                android:gravity="center"
                android:text="@string/ok"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="10dp"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="0.73:0.32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtContent1" />

            <TextView
                android:id="@+id/btnNo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_8_color_loading"
                android:fontFamily="@font/rufing_personaluse"
                android:gravity="center"
                android:text="@string/no"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="20dp"
                android:textColor="@color/app_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="0.73:0.32"
                app:layout_constraintStart_toEndOf="@+id/btnYes"
                app:layout_constraintTop_toBottomOf="@+id/txtContent" />

            <TextView
                android:id="@+id/btnYes"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_btn_loading_yes"
                android:fontFamily="@font/rufing_personaluse"
                android:gravity="center"
                android:text="@string/tv_yes"
                android:textSize="16sp"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintDimensionRatio="0.73:0.32"
                app:layout_constraintEnd_toStartOf="@+id/btnNo"
                app:layout_constraintTop_toTopOf="@+id/btnNo" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>